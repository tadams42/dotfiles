# Most of chezmoi config make sense only on local, main laptop machine.
#
# Some of exported configuration makes zero sense on `root` accounts and only pollutes
# root's env.
#
# For these reasons, we define `data.isFullSet` and `data.isUserRoot`.
# They can be used in chezmoi templates to emit only parts of config that is necessary.
#
# For shell scripts, we even avoid emitting parts of config instead of just blocking it
# by shell's check for ie. root account:
#
# ```sh
# if [ "$EUID" -ne 0 ] ; then
#     # ...
# fi
# ```

{{- $fullSetHosts := list "angie-ubuntu" "tellus-office-nuc" }}
{{- $isInFullSetHosts := has .chezmoi.hostname $fullSetHosts }}
{{- $isUserRoot := eq (int .chezmoi.uid) 0 }}

[data]
    isFullSet = {{ $isInFullSetHosts }}
    isSmallSubset = {{ not $isInFullSetHosts }}
    isUserRoot = {{ $isUserRoot }}

{{- if and $isInFullSetHosts (not $isUserRoot) }}

[edit]
    command = "code"
    args = ["--wait"]

[diff]
    pager = "delta"

    # command = "meld"
    # args = ["--diff", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

    # command = "code"
    # args = ["--wait", "--diff"]

[merge]
    # To integrate neovim:
    command = "nvim"
    args = [
        "-d",
        "{{ "{{" }} .Destination {{ "}}" }}",
        "{{ "{{" }} .Source {{ "}}" }}",
        "{{ "{{" }} .Target {{ "}}" }}"
    ]

    # To integrate VSCode:
    # command = "bash"
    # args = [
    #   "-c",
    #   "cp {{ "{{" }} .Target {{ "}}" }} {{ "{{" }} .Target {{ "}}" }}.base && code --new-window --wait --merge {{ "{{" }} .Destination {{ "}}" }} {{ "{{" }} .Target {{ "}}" }} {{ "{{" }} .Target {{ "}}" }}.base {{ "{{" }} .Source {{ "}}" }}",
    # ]

{{- end }}
