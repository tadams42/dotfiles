#!/usr/bin/zsh

{{- if and (not .isRoot) .isMainLaptop }}

# Don't rely on cargo to setup $PATH because it is doing it wrong - it uses
# hardcoded $HOME/.cargo instead of $CARGO_HOME/
#
# . "$HOME/.local/share/cargo/env"
export RUSTUP_HOME="${XDG_DATA_HOME}/rustup"
export CARGO_HOME="${XDG_DATA_HOME}/cargo"
export PATH="${CARGO_HOME}/bin:$PATH"

{{- end }}
