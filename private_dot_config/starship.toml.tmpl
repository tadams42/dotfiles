{{- $isRemote := not (default false (index . "isMainLaptop")) -}}
{{- $isRoot := eq (int .chezmoi.uid) 0 -}}

# Get editor completions based on the config schema
"$schema" = 'https://starship.rs/config-schema.json'

# Two lines prompt:
# 1. right aligned; every module from default `format` not explicitly specified in our
#    `format`
# 2. username, hostname, current directory and actual prompt
format = """
$username\
$hostname: \
$directory\
$fill\
$all\
$line_break\
$character
"""

# Move the rest of the prompt to the right but this only works for single-line prompts.
# In our case, we want two-line prompt.
# right_format = """$all"""
right_format = ''
# A continuation prompt that displays two filled in arrows
continuation_prompt = '▶▶'
# Inserts blank line between shell prompts.
add_newline = false

# Sets user-defined palette
# Palettes must be defined _after_ this line
palette = "catppuccin_mocha"

[fill]
symbol = ' '

# Replace the "❯" symbol in the prompt with "➜"
# [character] # The name of the module we are configuring is "character"
# success_symbol = "[➜](bold green)" # The "success_symbol" segment is being set to "➜" with the color "bold green"

[username]
# Shown if:
# - The current user is root/admin
# - The current user isn't the same as the one that is logged in
# - The user is currently connected as an SSH session
show_always = false
format = '[$user]($style)'


[hostname]
ssh_only = false
# ssh_symbol = " "

{{- if $isRemote }}
ssh_symbol = '🌐'
{{- else }}
ssh_symbol = '@'
{{- end }}

# format = '[$ssh_symbol$hostname]($style)'
{{- if $isRemote }}
format = '[🌐$hostname]($style)'
{{- else }}
format = '[@$hostname]($style)'
{{- end }}


[directory]
read_only = " 󰌾"
disabled = false
# truncation_length = 3
truncate_to_repo = true
truncation_length = 8
truncation_symbol = "…/"


[cmd_duration]
disabled = true


[python]
disabled = false
pyenv_version_name = false
# python_binary = ["./venv/bin/python", "python", "python3"]
# symbol = " "
# symbol = "🐍 "


[vagrant]
disabled = true
symbol = " "


[aws]
disabled = true
symbol = " "

# [os]
# disabled = false

